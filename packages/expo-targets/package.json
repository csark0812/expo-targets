{
  "name": "expo-targets",
  "version": "1.8.4",
  "description": "Expo config plugin for Apple targets and Android app extensions",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "bin": {
    "expo-targets": "./bin/expo-targets.js"
  },
  "files": [
    "bin",
    "build",
    "cli/build",
    "plugin/build",
    "metro/build",
    "app.plugin.js",
    "ios",
    "android",
    "expo-module.config.json",
    "extension-bundle-assets.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js"
    },
    "./extension-bundle-assets": "./extension-bundle-assets.js",
    "./metro": {
      "import": "./metro/build/index.js",
      "require": "./metro/build/index.js"
    },
    "./plugin": {
      "import": "./plugin/build/index.js",
      "require": "./plugin/build/index.js",
      "types": "./plugin/build/index.d.ts"
    },
    "./app.plugin.js": {
      "import": "./app.plugin.js",
      "require": "./app.plugin.js"
    },
    "./codegen": {
      "import": "./plugin/build/codegen/index.js",
      "require": "./plugin/build/codegen/index.js",
      "types": "./plugin/build/codegen/index.d.ts"
    },
    "./cli/sync": {
      "import": "./cli/build/sync.js",
      "require": "./cli/build/sync.js",
      "types": "./cli/build/sync.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:main && bun run build:plugin && bun run build:metro && bun run build:cli",
    "build:main": "tsc",
    "build:plugin": "tsc --project plugin/tsconfig.build.json && bun run copy:templates",
    "build:metro": "tsc --project metro/tsconfig.build.json",
    "build:cli": "tsc --project cli/tsconfig.build.json",
    "copy:templates": "mkdir -p plugin/build/ios/templates && cp plugin/src/ios/templates/*.swift plugin/build/ios/templates/",
    "clean": "rm -rf build plugin/build metro/build",
    "prepare": "bun run build",
    "lint": "biome lint src",
    "test": "bun test",
    "test:unit": "bun test"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@expo/config": "~57.0.6",
    "@expo/config-plugins": "~57.0.6",
    "@expo/config-types": "~57.0.2",
    "@expo/plist": "^0.8.1",
    "@react-native/normalize-colors": "^0.79.2",
    "commander": "^11.1.0",
    "debug": "^4.3.4",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.2",
    "prompts": "^2.4.2",
    "xcode": "3.0.1",
    "expo-widgets": "~57.0.9",
    "@expo/ui": "~57.0.10"
  },
  "devDependencies": {
    "@react-native-community/cli": "^16.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.2.21",
    "@types/fs-extra": "^11.0.4",
    "@types/prompts": "^2.4.9",
    "typescript": "~5.3.3"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-constants": "*"
  },
  "keywords": [
    "expo",
    "expo-plugin",
    "expo-config-plugin",
    "config-plugin",
    "react-native",
    "react-native-widget",
    "ios",
    "android",
    "swift",
    "swiftui",
    "kotlin",
    "widget",
    "widgets",
    "home-screen-widget",
    "widgetkit",
    "glance",
    "jetpack-compose",
    "app-clip",
    "app-clips",
    "appclip",
    "instant-app",
    "share-extension",
    "share",
    "action-extension",
    "action",
    "imessage",
    "imessage-stickers",
    "stickers",
    "sticker-pack",
    "messages",
    "messages-extension",
    "safari-extension",
    "notification-extension",
    "notification-content",
    "notification-service",
    "siri",
    "siri-intents",
    "app-intents",
    "apple-targets",
    "app-extension",
    "ios-extension",
    "native-module",
    "app-groups",
    "userdefaults",
    "shared-preferences",
    "data-sharing",
    "cross-process"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/csark0812/expo-targets"
  },
  "author": "Christopher Sarkissian",
  "homepage": "https://github.com/csark0812/expo-targets#readme",
  "license": "MIT"
}
