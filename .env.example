# Copy to .env (gitignored). Bun loads .env automatically.

# Apple team for native example / signing flows
APPLE_TEAM_ID=

# APNs Auth Key for Simulator NSE green (notification-service journey).
# Create at developer.apple.com → Keys → Apple Push Notifications.
# Store the .p8 outside the repo; never commit it.
# APNS_TEAM_ID is usually the same as APPLE_TEAM_ID.
APNS_AUTH_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Optional override; defaults to the host bundle id
# APNS_TOPIC=com.expotargets.example.notification-service

# Read token for private @csark0812/devicewright (npmjs granular access token).
# Used by root .npmrc: //registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}
# https://www.npmjs.com/settings/csark0812/tokens
NODE_AUTH_TOKEN=

# Absolute path to the `idb` CLI if it is not on PATH.
# Companion: brew install idb-companion (facebook/fb). CLI: pip3 install --user fb-idb
# DEVICEWRIGHT_IDB_PATH=/Users/YOU/Library/Python/3.9/bin/idb
