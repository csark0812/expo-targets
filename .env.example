# Copy to .env (gitignored). Bun loads .env automatically.

# Apple team for native example / signing flows
APPLE_TEAM_ID=

# APNs Auth Key for Simulator NSE green (notification-service journey).
# Create at developer.apple.com → Keys → Apple Push Notifications.
# Store the .p8 outside the repo; never commit it.
# APNS_TEAM_ID is usually the same as APPLE_TEAM_ID.
APNS_AUTH_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Optional override; defaults to the host bundle id
# APNS_TOPIC=com.expotargets.example.notification-service

# FCM HTTP v1 for Android notification-service / notification-content shade green.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Store the JSON outside the repo; never commit it. Also place google-services.json
# in the example app (expo-notifications) so the host can mint an FCM token.
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
# Alias accepted by the suite: GOOGLE_APPLICATION_CREDENTIALS
