{
  "expo": {
    "name": "ET Trick",
    "slug": "example-trick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "expotargets-trick",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expotargets.example.trick",
      "deploymentTarget": "16.4",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.expotargets.example.trick"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "ET Trick",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSPhotoLibraryUsageDescription": "ET Trick uses Photos to demonstrate the photo-editing extension.",
        "NSPhotoLibraryAddUsageDescription": "ET Trick may save edited photos."
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B1220",
          "resizeMode": "contain"
        }
      ],
      "expo-notifications",
      [
        "expo-targets",
        {
          "debug": true
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.expotargets.example.trick"
    }
  }
}
