{
  "type": "safari",
  "name": "NativeSafari",
  "displayName": "ET Safari Target",
  "platforms": ["ios"],
  "appGroup": "group.com.expotargets.example.native.safari",
  "ios": {
    "bundleIdentifier": "com.expotargets.example.native.safari.safari",
    "displayName": "ET Safari Target",
    "infoPlist": {
      "NSExtension": {
        "NSExtensionPrincipalClass": "SafariWebExtensionHandler"
      }
    },
    "manifest": {
      "permissions": ["storage", "nativeMessaging"],
      "content_scripts": [
        {
          "matches": ["*://example.com/*", "*://*.example.com/*"],
          "js": ["content.js"]
        }
      ]
    }
  }
}
