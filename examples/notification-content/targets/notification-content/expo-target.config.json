{
  "type": "notification-content",
  "name": "NotificationContent",
  "displayName": "ET NCE Target",
  "platforms": ["ios", "android"],
  "appGroup": "group.com.expotargets.example.notification-content",
  "entry": "./targets/notification-content/index.tsx",
  "ios": {
    "bundleIdentifier": "com.expotargets.example.notification-content.notification-content",
    "displayName": "ET NCE Target",
    "infoPlist": {
      "NSExtension": {
        "NSExtensionPrincipalClass": "NotificationViewController",
        "NSExtensionAttributes": {
          "UNNotificationExtensionCategory": "myNotificationCategory",
          "UNNotificationExtensionInitialContentSizeRatio": 0.5,
          "UNNotificationExtensionDefaultContentHidden": true
        }
      }
    }
  },
  "android": {
    "channelId": "expo_targets_notification_content",
    "channelName": "ET NCE",
    "category": "myNotificationCategory"
  }
}
