<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFFFF">
    <TextView
        android:id="@+id/widget_helloremoteviews_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello RemoteViews"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#FF000000" />
    <TextView
        android:id="@+id/widget_helloremoteviews_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No message yet"
        android:textSize="13sp"
        android:textColor="#FF3C3C43" />
    <TextView
        android:id="@+id/widget_helloremoteviews_taps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="taps:0"
        android:textSize="12sp"
        android:textColor="#FF8E8E93" />
    <Button
        android:id="@+id/widget_helloremoteviews_bump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bump" />
</LinearLayout>
