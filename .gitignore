# Dependencies
node_modules/
.pnpm-store/
bun.lockb

# Build outputs
build/
.build/
dist/
*.tsbuildinfo

# images
Icons8/
# Compiled files in src directories (should only be in build/)
src/**/*.js
src/**/*.d.ts
src/**/*.d.ts.map
src/**/*.js.map

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Expo
.expo/
.expo-shared/

# iOS - auto-generated Expo prebuild projects (keep targets/*/ios templates)
examples/*/ios/
examples/native/*/ios/

# Sealed CNG Swift from expo-targets (never edit; regenerated on prebuild)
**/ios/**/ExpoTargetsGenerated/
*.xcworkspace
*.xcuserdata
Pods/
Podfile.lock

# Android - auto-generated Expo prebuild projects (keep targets/*/android templates)
examples/*/android/
examples/native/*/android/
*.apk
*.aab
.gradle/
local.properties

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Env files
.env
.env.local

# Apple APNs Auth Keys — never commit
*.p8
AuthKey_*.p8

# Ephemeral agent workspace (handoffs, etc.)
_agent/

# Devicewright suite run outputs (keep committed spikes + leftovers + matrix gates)
examples/.devicewright/artifacts/*
!examples/.devicewright/artifacts/spikes/
!examples/.devicewright/artifacts/spikes/**
!examples/.devicewright/artifacts/leftovers/
!examples/.devicewright/artifacts/leftovers/**
!examples/.devicewright/artifacts/matrix/
!examples/.devicewright/artifacts/matrix/**

# Target build artifacts (generated by expo-targets)
**/targets/*/ios/build/
**/targets/*/android/build/

# Target generated resources (regenerated from expo-target.config.json)
**/targets/*/android/res/

.cursor/*
!.cursor/mcp.json
