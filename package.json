{
  "name": "expo-targets-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/native/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p packages/expo-targets --noEmit && tsc -p packages/create-expo-target --noEmit && tsc -p packages/expo-targets-cli --noEmit && tsc -p packages/mcp-dev --noEmit",
    "mcp-dev": "bun run --filter mcp-dev build && node packages/mcp-dev/build/bin/mcp-dev.js",
    "validate:changed": "skeleton validate changed",
    "validate:ci": "skeleton validate changed --base origin/main",
    "audit:docs": "skeleton audit docs",
    "audit:skills": "skeleton audit skills",
    "audit:self": "skeleton audit self",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "bun test packages/expo-targets",
    "test:unit": "bun test packages/expo-targets",
    "test:integration": "bun test packages/expo-targets/plugin/src/ios/config-plugins/withXcodeChanges.integration.test.ts",
    "examples:maestro:share": "maestro test examples/share/.maestro/smoke.yaml",
    "examples:maestro:action": "maestro test examples/action/.maestro/smoke.yaml",
    "examples:maestro:messages": "maestro test examples/messages/.maestro/smoke.yaml",
    "examples:maestro:clip": "maestro test examples/clip/.maestro/smoke.yaml",
    "examples:maestro:stickers": "maestro test examples/stickers/.maestro/smoke.yaml",
    "examples:maestro:widgets": "maestro test examples/widgets/.maestro/smoke.yaml",
    "examples:maestro:kitchen-sink": "maestro test examples/kitchen-sink/.maestro/smoke-share.yaml examples/kitchen-sink/.maestro/smoke-action.yaml examples/kitchen-sink/.maestro/smoke-clip.yaml examples/kitchen-sink/.maestro/smoke-stickers.yaml examples/kitchen-sink/.maestro/smoke-widgets.yaml examples/kitchen-sink/.maestro/smoke-messages.yaml",
    "examples:maestro:native-share": "maestro test examples/native/share/.maestro/smoke.yaml",
    "examples:maestro:native-action": "maestro test examples/native/action/.maestro/smoke.yaml",
    "examples:maestro:native-clip": "maestro test examples/native/clip/.maestro/smoke.yaml",
    "examples:devicewright:dry-preflight": "bun examples/.devicewright/cli.ts dry-preflight",
    "examples:devicewright:matrix": "bun examples/.devicewright/cli.ts matrix --stubs-only",
    "examples:devicewright:matrix:live": "bun examples/.devicewright/cli.ts matrix --live-through=1",
    "examples:devicewright:matrix:ensure": "bun examples/.devicewright/cli.ts matrix --live-through=3 --no-fail-fast --ensure-install",
    "examples:devicewright:share": "bun examples/.devicewright/cli.ts matrix --ids=share",
    "examples:devicewright:action": "bun examples/.devicewright/cli.ts matrix --ids=action",
    "examples:devicewright:messages": "bun examples/.devicewright/cli.ts matrix --ids=messages",
    "examples:devicewright:stickers": "bun examples/.devicewright/cli.ts matrix --ids=stickers",
    "examples:devicewright:clip": "bun examples/.devicewright/cli.ts matrix --ids=clip",
    "examples:devicewright:widgets": "bun examples/.devicewright/cli.ts matrix --ids=widgets"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@csark0812/devicewright": "^0.1.3",
    "@csark0812/skeleton": "^1.5.5",
    "typescript": "~5.3.3"
  },
  "version": "0.2.7",
  "dependencies": {
    "expo": "~54.0.25",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
