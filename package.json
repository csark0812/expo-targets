{
  "name": "expo-targets-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p packages/expo-targets --noEmit && tsc -p packages/create-expo-target --noEmit && tsc -p packages/expo-targets-cli --noEmit",
    "test": "bun install --frozen-lockfile --cwd tests/e2e && bun test --cwd tests/e2e",
    "test:prebuild": "bun test --cwd tests/e2e prebuild",
    "test:runtime": "bun test --cwd tests/e2e runtime",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.3.3"
  },
  "version": "0.2.7",
  "dependencies": {
    "expo": "~54.0.25",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
