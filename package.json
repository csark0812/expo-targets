{
  "name": "expo-targets-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/native/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p packages/expo-targets --noEmit && tsc -p packages/expo-targets-cli --noEmit",
    "validate:changed": "skeleton validate changed",
    "validate:ci": "skeleton validate changed --base origin/main",
    "audit:docs": "skeleton audit docs",
    "audit:skills": "skeleton audit skills",
    "audit:self": "skeleton audit self && bun test ./scripts/docs-guard.test.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "bun test packages/expo-targets && bun test ./examples/.devicewright/required.test.ts && bun test ./scripts/docs-guard.test.ts",
    "test:unit": "bun test packages/expo-targets && bun test ./scripts/docs-guard.test.ts",
    "test:devicewright": "bun test ./examples/.devicewright/required.test.ts",
    "test:integration": "bun test packages/expo-targets/plugin/src/ios/config-plugins/withXcodeChanges.integration.test.ts",
    "examples:devicewright:dry-preflight": "bun examples/.devicewright/cli.ts dry-preflight",
    "examples:devicewright:matrix": "bun examples/.devicewright/cli.ts matrix --stubs-only",
    "examples:devicewright:matrix:live": "bun examples/.devicewright/cli.ts matrix --live-through=1",
    "examples:devicewright:matrix:ensure": "bun examples/.devicewright/cli.ts matrix --live-through=3 --no-fail-fast --ensure-install",
    "examples:devicewright:share": "bun examples/.devicewright/cli.ts matrix --ids=share",
    "examples:devicewright:share:android": "bun examples/.devicewright/cli.ts matrix --ids=share --platform=android --device=emulator-5554 --live-through=1",
    "examples:devicewright:native-share:android": "bun examples/.devicewright/cli.ts matrix --ids=native-share --platform=android --device=emulator-5554 --live-through=1",
    "examples:devicewright:action": "bun examples/.devicewright/cli.ts matrix --ids=action",
    "examples:devicewright:action:android": "bun examples/.devicewright/cli.ts matrix --ids=action --platform=android --device=emulator-5554 --live-through=1",
    "examples:devicewright:native-action:android": "bun examples/.devicewright/cli.ts matrix --ids=native-action --platform=android --device=emulator-5554 --live-through=1",
    "examples:devicewright:messages": "bun examples/.devicewright/cli.ts matrix --ids=messages",
    "examples:devicewright:stickers": "bun examples/.devicewright/cli.ts matrix --ids=stickers",
    "examples:devicewright:clip": "bun examples/.devicewright/cli.ts matrix --ids=clip",
    "examples:devicewright:widgets": "bun examples/.devicewright/cli.ts matrix --ids=widgets",
    "examples:devicewright:widgets:android": "bun examples/.devicewright/cli.ts matrix --ids=widgets --platform=android --device=emulator-5554 --live-through=3",
    "examples:devicewright:file-provider:android": "bun examples/.devicewright/cli.ts matrix --ids=file-provider --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:keyboard:android": "bun examples/.devicewright/cli.ts matrix --ids=keyboard --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:file-provider-ui:android": "bun examples/.devicewright/cli.ts matrix --ids=file-provider-ui --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:credentials-provider:android": "bun examples/.devicewright/cli.ts matrix --ids=credentials-provider --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:call-directory:android": "bun examples/.devicewright/cli.ts matrix --ids=call-directory --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:print-service:android": "bun examples/.devicewright/cli.ts matrix --ids=print-service --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:network-packet-tunnel:android": "bun examples/.devicewright/cli.ts matrix --ids=network-packet-tunnel --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:notification-service:android": "bun examples/.devicewright/cli.ts matrix --ids=notification-service --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:notification-content:android": "bun examples/.devicewright/cli.ts matrix --ids=notification-content --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:native-notification-content:android": "bun examples/.devicewright/cli.ts matrix --ids=native-notification-content --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:app-intent:android": "bun examples/.devicewright/cli.ts matrix --ids=app-intent --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:photo-editing:android": "bun examples/.devicewright/cli.ts matrix --ids=photo-editing --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:wallet:android": "bun examples/.devicewright/cli.ts matrix --ids=wallet --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:wallet-ui:android": "bun examples/.devicewright/cli.ts matrix --ids=wallet-ui --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:spotlight:android": "bun examples/.devicewright/cli.ts matrix --ids=spotlight --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:spotlight-delegate:android": "bun examples/.devicewright/cli.ts matrix --ids=spotlight-delegate --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:bg-download:android": "bun examples/.devicewright/cli.ts matrix --ids=bg-download --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:message-filter:android": "bun examples/.devicewright/cli.ts matrix --ids=message-filter --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:unwanted-communication:android": "bun examples/.devicewright/cli.ts matrix --ids=unwanted-communication --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:watch:android": "bun examples/.devicewright/cli.ts matrix --ids=watch --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:watch-widget:android": "bun examples/.devicewright/cli.ts matrix --ids=watch-widget --platform=android --device=emulator-5554 --live-through=5",
    "examples:devicewright:android:matrix": "bun examples/.devicewright/cli.ts matrix --platform=android --device=emulator-5554 --live-through=5 --no-fail-fast"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@csark0812/devicewright": "^0.1.15",
    "@csark0812/skeleton": "^1.5.7",
    "typescript": "~5.3.3"
  },
  "version": "0.2.7",
  "dependencies": {
    "@expo/config-plugins": "^57.0.6",
    "expo": "~57.0.9",
    "expo-updates": "^57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}
