{
  "name": "expo-targets-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/native/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p packages/expo-targets --noEmit && tsc -p packages/expo-targets-cli --noEmit && tsc -p examples/.agent-device --noEmit",
    "validate:changed": "skeleton validate changed",
    "validate:ci": "skeleton validate changed --base origin/main",
    "audit:docs": "skeleton audit docs",
    "audit:skills": "skeleton audit skills",
    "audit:self": "skeleton audit self && bun test ./scripts/docs-guard.test.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "bun test --cwd packages/expo-targets && bun run test:agent-device && bun test ./scripts/docs-guard.test.ts",
    "test:unit": "bun test --cwd packages/expo-targets && bun test ./scripts/docs-guard.test.ts",
    "test:agent-device": "bun test ./examples/.agent-device/*.test.ts",
    "test:integration": "bun test --cwd packages/expo-targets plugin/src/ios/config-plugins/withXcodeChanges.integration.test.ts",
    "examples:agent-device:dry-preflight": "bun examples/.agent-device/cli.ts dry-preflight",
    "examples:agent-device:acceptance": "bun examples/.agent-device/cli.ts acceptance",
    "examples:agent-device:release-builds": "bun examples/.agent-device/cli.ts release-builds",
    "examples:agent-device:matrix": "bun examples/.agent-device/cli.ts matrix --stubs-only",
		"examples:agent-device:matrix:live": "bun examples/.agent-device/cli.ts matrix --live-through=1",
		"examples:agent-device:matrix:ensure": "bun examples/.agent-device/cli.ts matrix --live-through=3 --no-fail-fast --ensure-install",
		"examples:agent-device:ios:matrix": "bun examples/.agent-device/cli.ts matrix --platform=ios --live-through=5 --no-fail-fast",
    "examples:agent-device:share": "bun examples/.agent-device/cli.ts matrix --ids=share",
    "examples:agent-device:share:android": "bun examples/.agent-device/cli.ts matrix --ids=share --platform=android --device=emulator-5554 --live-through=1",
    "examples:agent-device:native-share:android": "bun examples/.agent-device/cli.ts matrix --ids=native-share --platform=android --device=emulator-5554 --live-through=1",
    "examples:agent-device:action": "bun examples/.agent-device/cli.ts matrix --ids=action",
    "examples:agent-device:action:android": "bun examples/.agent-device/cli.ts matrix --ids=action --platform=android --device=emulator-5554 --live-through=1",
    "examples:agent-device:native-action:android": "bun examples/.agent-device/cli.ts matrix --ids=native-action --platform=android --device=emulator-5554 --live-through=1",
    "examples:agent-device:messages": "bun examples/.agent-device/cli.ts matrix --ids=messages",
    "examples:agent-device:stickers": "bun examples/.agent-device/cli.ts matrix --ids=stickers",
    "examples:agent-device:clip": "bun examples/.agent-device/cli.ts matrix --ids=clip",
    "examples:agent-device:widgets": "bun examples/.agent-device/cli.ts matrix --ids=widgets",
    "examples:agent-device:widgets:android": "bun examples/.agent-device/cli.ts matrix --ids=widgets --platform=android --device=emulator-5554 --live-through=3",
    "examples:agent-device:widgets-expo-ui": "bun examples/.agent-device/cli.ts matrix --ids=widgets-expo-ui --live-through=3",
    "examples:agent-device:widgets-expo-ui:android": "bun examples/.agent-device/cli.ts matrix --ids=widgets-expo-ui --platform=android --device=emulator-5554 --live-through=3",
    "examples:agent-device:widgets-remoteviews:android": "bun examples/.agent-device/cli.ts matrix --ids=widgets-remoteviews --platform=android --device=emulator-5554 --live-through=3",
    "examples:agent-device:file-provider:android": "bun examples/.agent-device/cli.ts matrix --ids=file-provider --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:keyboard:android": "bun examples/.agent-device/cli.ts matrix --ids=keyboard --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:file-provider-ui:android": "bun examples/.agent-device/cli.ts matrix --ids=file-provider-ui --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:credentials-provider:android": "bun examples/.agent-device/cli.ts matrix --ids=credentials-provider --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:call-directory:android": "bun examples/.agent-device/cli.ts matrix --ids=call-directory --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:print-service:android": "bun examples/.agent-device/cli.ts matrix --ids=print-service --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:network-packet-tunnel:android": "bun examples/.agent-device/cli.ts matrix --ids=network-packet-tunnel --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:notification-service:android": "bun examples/.agent-device/cli.ts matrix --ids=notification-service --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:notification-content:android": "bun examples/.agent-device/cli.ts matrix --ids=notification-content --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:native-notification-content:android": "bun examples/.agent-device/cli.ts matrix --ids=native-notification-content --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:app-intent:android": "bun examples/.agent-device/cli.ts matrix --ids=app-intent --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:photo-editing:android": "bun examples/.agent-device/cli.ts matrix --ids=photo-editing --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:wallet:android": "bun examples/.agent-device/cli.ts matrix --ids=wallet --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:wallet-ui:android": "bun examples/.agent-device/cli.ts matrix --ids=wallet-ui --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:spotlight:android": "bun examples/.agent-device/cli.ts matrix --ids=spotlight --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:spotlight-delegate:android": "bun examples/.agent-device/cli.ts matrix --ids=spotlight-delegate --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:bg-download:android": "bun examples/.agent-device/cli.ts matrix --ids=bg-download --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:message-filter:android": "bun examples/.agent-device/cli.ts matrix --ids=message-filter --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:unwanted-communication:android": "bun examples/.agent-device/cli.ts matrix --ids=unwanted-communication --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:watch:android": "bun examples/.agent-device/cli.ts matrix --ids=watch --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:watch-widget:android": "bun examples/.agent-device/cli.ts matrix --ids=watch-widget --platform=android --device=emulator-5554 --live-through=5",
    "examples:agent-device:android:matrix": "bun examples/.agent-device/cli.ts matrix --platform=android --device=emulator-5554 --live-through=5 --no-fail-fast"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@csark0812/skeleton": "^1.5.7",
    "agent-device": "https://github.com/csark0812/agent-device/releases/download/v0.21.15-et.3/csark0812-agent-device-0.21.15-et.3.tgz",
    "typescript": "~5.3.3"
  },
  "version": "0.2.7",
  "dependencies": {
    "@expo/config-plugins": "^57.0.6",
    "expo": "~57.0.9",
    "expo-updates": "^57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}
