{
  "name": "expo-targets-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p packages/expo-targets --noEmit && tsc -p packages/create-expo-target --noEmit && tsc -p packages/expo-targets-cli --noEmit && tsc -p packages/devicewright --noEmit",
    "devicewright:doctor": "bun run --filter @expo-targets/devicewright doctor",
    "devicewright:mcp": "bun run --filter @expo-targets/devicewright mcp",
    "test": "bun install --frozen-lockfile --cwd tests/e2e && bun test --cwd tests/e2e",
    "test:prebuild": "bun test --cwd tests/e2e prebuild",
    "test:runtime": "bun test --cwd tests/e2e runtime",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "~5.3.3"
  },
  "version": "0.2.7",
  "dependencies": {
    "expo": "~54.0.25",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
