{
  "name": "expo-targets-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/native/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p packages/expo-targets --noEmit && tsc -p packages/create-expo-target --noEmit && tsc -p packages/expo-targets-cli --noEmit",
    "validate:changed": "skeleton validate changed",
    "validate:ci": "skeleton validate changed --base origin/main",
    "audit:docs": "skeleton audit docs",
    "audit:skills": "skeleton audit skills",
    "audit:self": "skeleton audit self && bun test ./scripts/docs-guard.test.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "bun test packages/expo-targets && bun test ./examples/.devicewright/required.test.ts && bun test ./scripts/docs-guard.test.ts",
    "test:unit": "bun test packages/expo-targets && bun test ./scripts/docs-guard.test.ts",
    "test:devicewright": "bun test ./examples/.devicewright/required.test.ts",
    "test:integration": "bun test packages/expo-targets/plugin/src/ios/config-plugins/withXcodeChanges.integration.test.ts",
    "examples:devicewright:dry-preflight": "bun examples/.devicewright/cli.ts dry-preflight",
    "examples:devicewright:matrix": "bun examples/.devicewright/cli.ts matrix --stubs-only",
    "examples:devicewright:matrix:live": "bun examples/.devicewright/cli.ts matrix --live-through=1",
    "examples:devicewright:matrix:ensure": "bun examples/.devicewright/cli.ts matrix --live-through=3 --no-fail-fast --ensure-install",
    "examples:devicewright:share": "bun examples/.devicewright/cli.ts matrix --ids=share",
    "examples:devicewright:action": "bun examples/.devicewright/cli.ts matrix --ids=action",
    "examples:devicewright:messages": "bun examples/.devicewright/cli.ts matrix --ids=messages",
    "examples:devicewright:stickers": "bun examples/.devicewright/cli.ts matrix --ids=stickers",
    "examples:devicewright:clip": "bun examples/.devicewright/cli.ts matrix --ids=clip",
    "examples:devicewright:widgets": "bun examples/.devicewright/cli.ts matrix --ids=widgets"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@csark0812/devicewright": "0.1.14",
    "@csark0812/skeleton": "^1.5.7",
    "typescript": "~5.3.3"
  },
  "version": "0.2.7",
  "dependencies": {
    "@expo/config-plugins": "^57.0.6",
    "expo": "~57.0.9",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}
